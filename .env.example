# Server-only loopback targets. Browser code receives relative /bridge URLs only.
BIST_VIEWER_MATRIKS_URL=http://127.0.0.1:8788/api
BIST_VIEWER_PRICE_URL=http://127.0.0.1:8789/api

# Server-only SQLite locations. Relative paths resolve from this repository root.
BIST_VIEWER_BARS_DB=../DailyDataAggregator/data/bars.db
BIST_VIEWER_ORDER_DB=../MatriksOrder/data/matriksorder.db
BIST_VIEWER_WIRE_LOG_DB=../MatriksOrder/data/wire-log.db
BIST_VIEWER_API_LOG_DB=../MatriksOrder/data/api-log.db

# Server-only BistData DuckDB locations. These are read once a night by the snapshot
# worker and never on a request: an open DuckDB connection, read-only included, locks
# BistData's own pipeline out of its next sync.
BIST_VIEWER_BISTDATA_MINUTE_DB=../BistData/data/minute.duckdb
BIST_VIEWER_BISTDATA_SCALE_DB=../BistData/data/scale.duckdb
# The viewer's own derived cache. Deleting it loses nothing; the next window rebuilds it.
BIST_VIEWER_INTENT_CACHE_DB=data/intent-bars.db
